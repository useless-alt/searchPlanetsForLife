# Supabase — доступ к каталогам экзопланет.
#
# Скопируйте этот файл в `.env.local` рядом с ним и впишите свои значения:
#   cp .env.example .env.local
#
# Файл `.env.local` не коммитится (см. .gitignore).
#
# SUPABASE_URL — URL проекта из Supabase Dashboard -> Project Settings -> API:
#   https://<project-ref>.supabase.co
#
# SUPABASE_SERVICE_ROLE_KEY — ключ доступа к базе. Поддерживаются два вида:
#   * sb_secret_… или legacy service_role JWT — ключ проекта (Dashboard -> API Keys);
#   * sbp_… — Personal Access Token (Dashboard -> Account -> Access Tokens);
#     тогда сервер сам возьмёт ключ проекта через management API.
# В обоих случаях значение используется ТОЛЬКО на сервере: в Edge-функции
# `/api/catalog` и в скриптах загрузки. Во фронтенд оно не попадает.
#
# SUPABASE_CATALOG_WRITE_KEY — дополнительный ключ для записи данных.
# Если он задан, браузер может загружать выгрузки в базу только с этим ключом
# (заголовок x-catalog-key). Не задан — запись через API закрыта,
# загрузка возможна скриптом `npm run upload:catalog` по service-role ключу.
#
# Пример:
# SUPABASE_URL=https://abcdefghijklmnop.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx   (или sbp_xxx — Personal Access Token)
# SUPABASE_CATALOG_WRITE_KEY=любой-длинный-секрет-для-записи

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CATALOG_WRITE_KEY=
