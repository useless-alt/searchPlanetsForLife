# Supabase — хранилище каталогов экзопланет.
# Подробности и примеры — в frontend/.env.example.
# Секретный ключ (service_role) допустим только в серверном окружении:
# переменные Vercel или локальный frontend/.env.local. В бандл фронтенда он не попадает.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CATALOG_WRITE_KEY=
