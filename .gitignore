node_modules/
dist/
coverage/
*.tsbuildinfo

# Локальное окружение с секретами не коммитим.
.env
.env.local
.env.*.local

# Рабочие материалы вне git (промпт, заметки).
prompt.txt
заметки.md
notes.md

# Архивный код черновика (не участвует в сборке).
archive/

# Резервные копии источников не коммитим, кроме плейсхолдера каталога.
data/backups/*
!data/backups/.gitkeep
# Страховка для проверяющего: в репозитории лежат только актуальные снимки
# источников (`latest.json`), версии с таймстампами остаются локальными (п. 8.2).
!data/backups/nasa/
!data/backups/exoplanet_eu/
!data/backups/exomercat/
!data/backups/gaia/
!data/backups/simbad/
!data/backups/exomast/
data/backups/nasa/*
data/backups/exoplanet_eu/*
data/backups/exomercat/*
data/backups/gaia/*
data/backups/simbad/*
data/backups/exomast/*
!data/backups/*/latest.json
!data/backups/exomast/index.json

# Локальные архивы резервных копий (выгрузка в Supabase).
data/archives/

# Статический снимок каталога для GitHub Pages (собирается скриптом).
apps/web/public/data/

# Журнал ошибок загрузки — локальный append-only файл (U31).
data/error-log.jsonl

# Рабочие данные запущенного workspace-сервера (cwd = apps/server).
apps/server/data/

# Прочее окружение агента и служебные каталоги.
agent-rules/
.agent/
.agents/
.taste-skill/
.vercel/
build/
__pycache__/
*.pyc
.DS_Store

# --- 27a: кадры дизайн-ревизии и собранная заглушка каталога ---
docs/screens/
e2e/fixtures/catalog.json

# --- Артефакты прогонов: отчёты Playwright и временные файлы отладки ---
.e2e-results/
.tmp/
