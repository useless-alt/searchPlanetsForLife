# Порт HTTP-сервера каталога (apps/server).
PORT=8787

# Каталог резервных копий источников на диске сервера (п. 8.1).
BACKUP_DIR=data/backups

# Сколько версий резервной копии хранить на источник (п. 8.2). Минимум 5, настраивается.
BACKUP_KEEP_VERSIONS=5

# Таймаут сетевых запросов к научным API, мс. В ТЗ не задан — решение исполнителя.
FETCH_TIMEOUT_MS=30000

# Автоматическое обновление каталога сразу после старта сервера (POST /api/refresh не нужен).
# По умолчанию: 0, если стартовый снимок найден на диске, иначе 1.
# 1 — всегда обновлять при старте, 0 — никогда (только кнопка или npm run refresh).
EXO_AUTO_REFRESH=

# Явный стартовый снимок (JSON или .json.gz). По умолчанию сервер ищет
# BACKUP_DIR/merged/latest.json, затем data/demo/catalog.json.gz из репозитория.
EXO_SNAPSHOT=

# Каталог собранного веб-приложения, которое раздаёт сервер.
# По умолчанию — apps/web/dist рядом с apps/server.
WEB_DIST=

