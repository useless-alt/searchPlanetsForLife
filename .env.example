# Порт HTTP-сервера каталога (apps/server).
PORT=8787

# Каталог резервных копий источников на диске сервера (п. 8.1).
BACKUP_DIR=data/backups

# Сколько версий резервной копии хранить на источник (п. 8.2). Минимум 5, настраивается.
BACKUP_KEEP_VERSIONS=5

# Таймаут сетевых запросов к научным API, мс. В ТЗ не задан — решение исполнителя.
FETCH_TIMEOUT_MS=30000
